APP_NAME=CentFlow
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
DATABASE_URL=sqlite:///./centflow.db
MARKET_DATA_PROVIDER=mock
MARKET_DATA_CACHE_ENABLED=true
QUOTE_CACHE_TTL_SECONDS=15
HISTORY_CACHE_TTL_SECONDS=300
SEARCH_CACHE_TTL_SECONDS=600
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Identity, Session & Security
SESSION_SECRET_KEY=change-me-to-a-secure-random-32-byte-hex-in-production
SESSION_COOKIE_NAME=centflow_session
SESSION_COOKIE_TTL_DAYS=7
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
CSRF_COOKIE_NAME=centflow_csrf

# Google OAuth 2.0 (Optional / Mock Provider by default)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/google/callback
FRONTEND_BASE_URL=http://localhost:5173
